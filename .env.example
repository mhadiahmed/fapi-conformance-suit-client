# ============================================================================
# OpenID FAPI Conformance Client — Configuration
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit secrets.
# ============================================================================

# ----- Conformance suite credentials ----------------------------------------
# Required for the automated cert-run orchestrator (npm run cert-run).
# Generate the API token at: https://www.certification.openid.net/tokens.html
SUITE_TOKEN=paste-your-api-token-here

# Required: the test plan ID you've created in the suite UI.
# Find it in the URL of your plan-detail.html page.
SUITE_PLAN_ID=paste-your-plan-id-here

# ----- Conformance suite endpoints ------------------------------------------
# Defaults are the OpenID Foundation's public hosted suite. Override only if
# you're running a self-hosted instance.
# SUITE_BASE=https://www.certification.openid.net
# SUITE_MTLS_BASE=https://mtls-www.certification.openid.net

# ----- Your plan's alias ----------------------------------------------------
# The alias name you gave when creating the plan in the UI. Used to build
# discovery/token/PAR/redirect URLs. Required when running the local CLI.
SUITE_ALIAS=ksa-rp-seentarbie

# ----- URLs the local CLI hits when invoked by the orchestrator -------------
# discoveryUrl: where your client fetches the OpenID configuration.
# resourceEndpoint: the protected resource your happy-path flow calls after
#   obtaining tokens (e.g. an Open Banking accounts endpoint).
# Both default to suite-hosted paths derived from SUITE_BASE + SUITE_ALIAS,
# but the resource endpoint usually needs to be customised.
SUITE_DISCOVERY_URL=https://www.certification.openid.net/test/a/ksa-rp-seentarbie/.well-known/openid-configuration
SUITE_RESOURCE_ENDPOINT=https://mtls-www.certification.openid.net/test-mtls/a/ksa-rp-seentarbie/open-banking/v1.1/accounts

# ----- Client identity -------------------------------------------------------
# Your registered client_id in the plan, plus the JWKS key IDs you use.
CLIENT_ID=bc680915-bbd3-45d7-b3c6-2716f4d178ed
KEY_ID=sig1

# Only needed if you exercise the encrypted-id_token tests, which use a
# second client registered with an encryption key.
CLIENT2_ID=06f42d27-c86b-481a-a134-18cf5e0d1e9c
CLIENT2_KEY_ID=sig2
